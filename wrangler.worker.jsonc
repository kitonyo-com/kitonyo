 "d1_databases":[{"binding":"DB","database_name":"kitonyo-orders","database_id":"cc70be56-ea02-4c50-896d-8e31cd018cbb","jurisdiction":"eu"}],
 "triggers":{"crons":["* * * * *"]},
 "observability":{"enabled":false}
}
